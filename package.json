{
  "name": "kyleaxity-stream-overlays",
  "version": "1.0.0",
  "private": true,
  "description": "Local keyboard, mouse and post-game overlays for OBS on Windows.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.cjs",
    "build": "powershell -NoProfile -File scripts/build.ps1",
    "assets": "node scripts/download-assets.cjs",
    "setup": "npm run build && npm run assets",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "uiohook-napi": "1.5.4"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
